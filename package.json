{
  "name": "omis-entry",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck -w web",
    "format": "npm run format -w web",
    "format:check": "npm run format:check -w web",
    "test": "npm run test -w web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level error"
  },
  "devDependencies": {
    "supabase": "^2.121.0"
  }
}
