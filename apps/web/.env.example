# Copy to .env.local (never committed).
# Local values come from `npx supabase status` after `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Error tracking (Phase 9). Leave empty locally: nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Build-time only, for uploading source maps from CI.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
