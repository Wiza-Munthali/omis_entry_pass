# Secrets for Edge Functions. Copy to supabase/functions/.env (never committed).
# Local: `supabase functions serve --env-file supabase/functions/.env`
# Remote: `supabase secrets set --env-file supabase/functions/.env`
# The service-role key is injected automatically as SUPABASE_SERVICE_ROLE_KEY.
RESEND_API_KEY=
EMAIL_FROM=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
