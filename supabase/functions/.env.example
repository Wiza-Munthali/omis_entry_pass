# Secrets for Edge Functions. Copy to supabase/functions/.env (never committed).
# Local: `npm run functions` (serves with this file)
# Remote: `npx supabase secrets set --env-file supabase/functions/.env`
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# Where links in emails point.
PORTAL_URL=http://localhost:3000
EMAIL_FROM=OMIS Entry <no-reply@ghii.test>

# Production email (Resend). Leave empty locally.
RESEND_API_KEY=
# Local email: Mailpit inside the Supabase Docker network.
MAILPIT_URL=http://supabase_inbucket_omis-entry:8025

# Shared secret the database sends when it calls Edge Functions (Vault: internal_hook_secret).
# Local value matches supabase/seed.sql; use a long random value in production.
INTERNAL_HOOK_SECRET=local-dev-only-internal-secret

# Push: Firebase service account key (Project settings → Service accounts → Generate new
# private key), the whole JSON on one line, in single quotes. Empty = no push, emails only.
FCM_SERVICE_ACCOUNT_JSON=
